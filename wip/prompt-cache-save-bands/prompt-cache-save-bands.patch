From 3ea0504e667242b05e9de640a0082f583a2ab011 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:14:23 +0800
Subject: [PATCH 2/2] server: a new prompt cache buffer of 64 MiB or more is
 faulted in with huge pages (Linux)

A prompt cache save of a long context needs a new buffer as large as the slot state (GiBs) whenever no recycled one is
large enough, and its zero fill faults it in 4 KiB pages: 1.6-1.7 s for 3.5 GiB on a 3900X, most of the save (the state
copy itself is ~0.3-0.45 s).  take() now reserves such a buffer, advises the 2 MiB-aligned part of it MADV_HUGEPAGE and
only then zero-fills it: ~0.4 s for the same 3.5 GiB (transparent huge pages in madvise mode).  Recycled buffers keep
their pages.  LLAMA_SERVER_CACHE_HUGEPAGE=0 restores the 4 KiB pages.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/server/server-task.cpp | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/tools/server/server-task.cpp b/tools/server/server-task.cpp
index 0104e6ac0..caf877377 100644
--- a/tools/server/server-task.cpp
+++ b/tools/server/server-task.cpp
@@ -12,6 +12,10 @@
 
 #include <sstream>
 
+#if defined(__linux__)
+#include <sys/mman.h>
+#endif
+
 //
 // task_params
 //
@@ -1751,6 +1755,17 @@ static bool prompt_cache_reuse() {
     return v;
 }
 
+// a new state buffer of a long context (GiBs) is faulted in by its zero fill, and in 4 KiB pages that fault in is most of
+// a prompt cache save: a 3.5 GiB slot state took 1.6-1.7 s to zero-fill on a 3900X, against ~0.4 s in 2 MiB pages
+// (transparent huge pages, madvise mode) and ~0.3 s for the state copy itself.  LLAMA_SERVER_CACHE_HUGEPAGE=0: 4 KiB pages
+static bool prompt_cache_hugepage() {
+    static const bool v = [] {
+        const char * e = getenv("LLAMA_SERVER_CACHE_HUGEPAGE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return v;
+}
+
 std::vector<uint8_t> server_prompt_cache::take(size_t n) {
     // the smallest spare that holds n bytes; resizing it down keeps the memory, resizing it up zero-fills only the tail
     size_t best = spare.size();
@@ -1764,6 +1779,19 @@ std::vector<uint8_t> server_prompt_cache::take(size_t n) {
         buf = std::move(spare[best]);
         spare.erase(spare.begin() + best);
     }
+#if defined(__linux__) && defined(MADV_HUGEPAGE)
+    else if (prompt_cache_hugepage() && n >= (64u << 20)) {
+        // reserve() only maps the buffer, so the advice is in place before the zero fill below touches a page; the huge
+        // pages cover the 2 MiB-aligned part of it (a failed madvise leaves 4 KiB pages, as before)
+        buf.reserve(n);
+        const uintptr_t huge = 2u << 20;
+        const uintptr_t beg  = ((uintptr_t) buf.data() + huge - 1) & ~(huge - 1);
+        const uintptr_t end  = ((uintptr_t) buf.data() + n) & ~(huge - 1);
+        if (end > beg) {
+            madvise((void *) beg, end - beg, MADV_HUGEPAGE);
+        }
+    }
+#endif
     buf.resize(n);
     return buf;
 }
-- 
