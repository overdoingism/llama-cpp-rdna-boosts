From 0450748927c2afef1b5ba455293f118796865013 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Fri, 30 Oct 2026 16:06:35 +0800
Subject: [PATCH] server: keep the target's speculative checkpoint in device
 memory when it fits (LLAMA_SERVER_SPEC_CKPT_DEVICE)

On a recurrent or hybrid target the server saves a checkpoint of the target's recurrent state before every verify whose
draft is longer than n_rs_seq (with an n-gram drafter: any n-gram draft longer than the rollback window) and overwrites it
at the next one.  It went to host memory: ~16 ms per save for Qwen3.8-27B's 150 MiB on gfx1201.  It now uses
LLAMA_STATE_SEQ_FLAGS_ON_DEVICE (one buffer per slot, kept and reused by the context), so a save and a restore are device
copies.  Decided once per slot, at its first checkpoint: device memory when the target is on exactly one GPU and that GPU
has the state's size plus 512 MiB free; otherwise host memory as before (logged).  LLAMA_SERVER_SPEC_CKPT_DEVICE=0: host
memory always (kill switch).  Context checkpoints are not touched.  The restored state is the same bytes either way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/server/server-context.cpp | 80 ++++++++++++++++++++++++++++++++-
 1 file changed, 78 insertions(+), 2 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index d8e83c73f..0eb706b7c 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -299,6 +299,11 @@ struct server_slot {
     std::vector<int32_t> spec_i_batch;
     common_prompt_checkpoint spec_ckpt;
 
+    // where the target's speculative checkpoints of this slot live (LLAMA_SERVER_SPEC_CKPT_DEVICE): 0 not decided yet,
+    // 1 device memory, -1 host memory; decided at the slot's first one and kept (a checkpoint is restored with the flags it
+    // was saved with, and the context keeps the slot's device buffer)
+    int spec_ckpt_device = 0;
+
     // n_tokens of the context checkpoint this task restored, while nothing has been decoded since (-1: none)
     int64_t n_tokens_ckpt_restored = -1;
     bool spec_is_replay = false;
@@ -1157,6 +1162,77 @@ private:
 
     std::vector<std::vector<uint8_t>> ckpt_spare;
 
+    // LLAMA_SERVER_SPEC_CKPT_DEVICE: where the target's speculative checkpoint is kept -- the one saved before a verify whose
+    // draft is longer than n_rs_seq (on a recurrent or hybrid target: an n-gram draft of up to --spec-ngram-mod-n-max tokens
+    // against a --spec-draft-n-max rollback window) and overwritten by the next.  In host memory a save of Qwen3.8-27B's
+    // 150 MiB recurrent state costs ~16 ms on gfx1201; with LLAMA_STATE_SEQ_FLAGS_ON_DEVICE (one buffer per slot, kept and
+    // reused by the context) a save and a restore are device copies of well under a ms.
+    // Device memory when the target is on exactly one GPU and, at the slot's first checkpoint, that GPU has the state's size
+    // plus SPEC_CKPT_DEVICE_HEADROOM free (a buffer allocated later, after an expert-cache arena or other caches took the
+    // GPU, must not take the last of it); otherwise host memory.  Logged once per slot.  LLAMA_SERVER_SPEC_CKPT_DEVICE=0:
+    // host memory always (the behaviour before this option).  Context checkpoints are not touched.
+    const bool spec_ckpt_device = [] {
+        const char * e = getenv("LLAMA_SERVER_SPEC_CKPT_DEVICE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    static constexpr size_t SPEC_CKPT_DEVICE_HEADROOM = 512ull << 20;
+
+    // the one GPU the target runs on, nullptr when there are several (a split model) or none
+    ggml_backend_dev_t spec_ckpt_gpu() const {
+        std::vector<ggml_backend_dev_t> gpus;
+        auto add = [&](ggml_backend_dev_t d, enum ggml_backend_dev_type type) {
+            if (d != nullptr && ggml_backend_dev_type(d) == type) {
+                gpus.push_back(d);
+            }
+        };
+        for (enum ggml_backend_dev_type type : { GGML_BACKEND_DEVICE_TYPE_GPU, GGML_BACKEND_DEVICE_TYPE_IGPU }) {
+            if (!params_base.devices.empty()) {
+                for (ggml_backend_dev_t d : params_base.devices) {
+                    add(d, type);
+                }
+            } else {
+                for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+                    add(ggml_backend_dev_get(i), type);
+                }
+            }
+            if (!gpus.empty()) {
+                break;
+            }
+        }
+        if (params_base.split_mode == LLAMA_SPLIT_MODE_NONE && params_base.main_gpu >= 0 && params_base.main_gpu < (int) gpus.size()) {
+            return gpus[params_base.main_gpu];
+        }
+        return gpus.size() == 1 ? gpus[0] : nullptr;
+    }
+
+    // the flags to save the slot's next target checkpoint with (decides the slot's memory at its first one)
+    llama_state_seq_flags spec_ckpt_save_flags_tgt(server_slot & slot) {
+        if (slot.spec_ckpt_device == 0) {
+            bool dev = false;
+            if (spec_ckpt_device) {
+                ggml_backend_dev_t gpu = spec_ckpt_gpu();
+                if (gpu == nullptr) {
+                    SLT_INF(slot, "%s\n", "speculative checkpoints of the target in host memory: the target is not on exactly one GPU");
+                } else {
+                    const size_t need = llama_state_seq_get_size_ext(slot.ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                    size_t free = 0;
+                    size_t total = 0;
+                    ggml_backend_dev_memory(gpu, &free, &total);
+                    dev = free >= need + SPEC_CKPT_DEVICE_HEADROOM;
+                    SLT_INF(slot, "speculative checkpoints of the target in %s memory (%.1f MiB; %.1f MiB free on %s)\n",
+                            dev ? "device" : "host", need / 1048576.0, free / 1048576.0, ggml_backend_dev_name(gpu));
+                }
+            }
+            slot.spec_ckpt_device = dev ? 1 : -1;
+        }
+        return spec_ckpt_load_flags_tgt(slot);
+    }
+
+    // the flags the slot's target checkpoints were saved with
+    static llama_state_seq_flags spec_ckpt_load_flags_tgt(const server_slot & slot) {
+        return LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY | (slot.spec_ckpt_device > 0 ? LLAMA_STATE_SEQ_FLAGS_ON_DEVICE : 0);
+    }
+
     void ckpt_recycle(common_prompt_checkpoint & ckpt) {
         if (!ckpt_reuse) {
             return;
@@ -4063,7 +4139,7 @@ private:
                 if (use_ckpt_tgt) {
                     //const int64_t t_start = ggml_time_us();
 
-                    ckpt.update_tgt(ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+                    ckpt.update_tgt(ctx_tgt, slot.id, spec_ckpt_save_flags_tgt(slot));
 
                     //const int64_t t_total = ggml_time_us() - t_start;
                     //printf("checkpoint total: %f ms\n", t_total / 1000.0);
@@ -5108,7 +5184,7 @@ private:
 
                         SLT_DBG(slot, "restoring speculative checkpoint (pos_min = %d, pos_max = %d, size = %zu)\n", ckpt.pos_min, ckpt.pos_max, ckpt.size());
 
-                        GGML_ASSERT(ckpt.load_tgt(slot.ctx_tgt, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
+                        GGML_ASSERT(ckpt.load_tgt(slot.ctx_tgt, slot.id, spec_ckpt_load_flags_tgt(slot)));
 
                         if (slot.ctx_dft) {
                             GGML_ASSERT(ckpt.load_dft(slot.ctx_dft, slot.id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY));
-- 
2.43.0

