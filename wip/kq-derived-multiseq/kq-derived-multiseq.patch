     // see llama_non_causal_type - same adjustment as set_input_kq_mask
     if (!causal_attn && hparams.non_causal_type == LLAMA_NON_CAUSAL_TYPE_SWA_ONLY) {
@@ -2273,7 +2343,7 @@ void llama_kv_cache::set_input_kq_derived(
