+        const llama_pos hi   = causal_attn ? p1 : (multi_seq ? KQ_DERIVED_SEQ_STRIDE - 1 : INT32_MAX);
 
               llama_pos lo   = 0;
 
@@ -2318,8 +2411,8 @@ void llama_kv_cache::set_input_kq_derived(
             lo = 0;
         }
 
-        tok_lo_data[ii] = (int32_t) lo;
-        tok_hi_data[ii] = (int32_t) hi;
