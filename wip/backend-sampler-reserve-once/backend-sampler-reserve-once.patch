From 59798c023177feba9dfdbc4f667d8cbdd111c273 Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Tue, 27 Oct 2026 05:40:20 +0800
Subject: [PATCH] llama: backend sampling: reserve once per sequence, not on
 every set_sampler()

llama_context::set_sampler() asked for a reserve whenever a backend sampler was set or removed, and the server sets a
new chain for every request (and removes it for a grammar request).  sched_reserve() re-creates the scheduler, so every
request freed and allocated all compute buffers again at the same size before its first token.  The behaviour is
llama.cpp's own (src/llama-context.cpp, unchanged on ggml-org master as of 2026-10-29).

Now a reserve is asked for only when the compute buffers were not reserved with a backend sampler for that sequence.
A chain set again or removed needs none: the graph is rebuilt anyway (the samplers are part of the reuse check), the
output buffers are sized per decode, and the graph allocator grows a buffer on demand if a chain ever needs more.

LLAMA_BACKEND_SAMPLER_RESERVE_ONCE=0 restores the reserve on every set / removal.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/llama-context.cpp | 33 +++++++++++++++++++++++++++++----
 src/llama-context.h   |  4 ++++
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index b52cc3ceb..ef1d1244e 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1418,6 +1418,12 @@ void llama_context::sched_reserve() {
         }
     }
 
+    // the buffers now cover a backend sampler for these sequences (see set_sampler)
+    sampling.reserved.clear();
+    for (const auto & entry : sampling.samplers) {
+        sampling.reserved.insert(entry.first);
+    }
+
     for (size_t i = 0; i < backend_ptrs.size(); ++i) {
         ggml_backend_t             backend = backend_ptrs[i];
         ggml_backend_buffer_type_t buft    = backend_buft[i];
@@ -2022,6 +2028,16 @@ void llama_context::set_warmup(bool value) {
     //sched_need_reserve = true;
 }
 
+// LLAMA_BACKEND_SAMPLER_RESERVE_ONCE=0: reserve the compute buffers again on every set or removal of a backend sampler,
+// as before (see set_sampler)
+static bool backend_sampler_reserve_once() {
+    static const bool enabled = [] {
+        const char * e = getenv("LLAMA_BACKEND_SAMPLER_RESERVE_ONCE");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    return enabled;
+}
+
 bool llama_context::set_sampler(llama_seq_id seq_id, llama_sampler * sampler) {
     if (!sampler && sampling.samplers.count(seq_id) == 0) {
         return true;
@@ -2055,7 +2071,13 @@ bool llama_context::set_sampler(llama_seq_id seq_id, llama_sampler * sampler) {
 
         sampling.samplers[seq_id] = sampler;
 
-        sched_need_reserve = true;
+        // A reserve re-creates the scheduler, which frees and allocates every compute buffer again, so ask for one only
+        // when the buffers were not reserved with a backend sampler for this sequence.  A chain set again (the server sets
+        // a new one for every request) or removed needs none: the graph is rebuilt anyway (its samplers are part of the
+        // reuse check), and the allocator grows a buffer if a chain ever needs more.
+        if (!backend_sampler_reserve_once() || sampling.reserved.count(seq_id) == 0) {
+            sched_need_reserve = true;
+        }
 
         return true;
     }
@@ -2063,18 +2085,21 @@ bool llama_context::set_sampler(llama_seq_id seq_id, llama_sampler * sampler) {
     if (sampler && !can_offload) {
         LLAMA_LOG_WARN("%s: sampler '%s' for seq_id = %d, cannot be offloaded to the backend\n", __func__, llama_sampler_name(sampler), seq_id);
 
-        if (sampling.samplers.count(seq_id) > 0) {
+        // no reserve: the buffers reserved with the sampler are large enough without it
+        if (!backend_sampler_reserve_once() && sampling.samplers.count(seq_id) > 0) {
             sched_need_reserve = true;
         }
-
         sampling.samplers.erase(seq_id);
 
         return false;
     }
 
+    // no reserve: the buffers reserved with the sampler are large enough without it
     sampling.samplers.erase(seq_id);
 
-    sched_need_reserve = true;
+    if (!backend_sampler_reserve_once()) {
+        sched_need_reserve = true;
+    }
 
     return true;
 }
diff --git a/src/llama-context.h b/src/llama-context.h
index b634acd74..70642005b 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -14,6 +14,7 @@
 
 #include <array>
 #include <map>
+#include <set>
 #include <vector>
 
 struct llama_model;
@@ -414,6 +415,9 @@ private:
         // !samplers.empty() to check if any samplers are active
         std::map<llama_seq_id, llama_sampler *> samplers;
 
+        // the sequences that had a backend sampler when the compute buffers were last reserved
+        std::set<llama_seq_id> reserved;
+
         buffer_view<float>       logits     = {nullptr, 0};
         buffer_view<llama_token> sampled    = {nullptr, 0};
         buffer_view<float>       probs      = {nullptr, 0};
-- 
2.43.0

