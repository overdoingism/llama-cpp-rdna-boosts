From bc7e53c40db2ed5f57bb29a85c5325bfba60819d Mon Sep 17 00:00:00 2001
From: overdoingism <overdoingism@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:10:57 +0800
Subject: [PATCH] speculative: DFlash2 adaptive verify width (opt-in), aligned
 across the sequences drafted together

With LLAMA_DFLASH_ADAPTIVE=1, a DFlash2 sequence drafts w tokens and sends them to verification; w follows per-position
acceptance estimates to the width with the most tokens per unit of step cost (cost model: 0.09 of the step's fixed part
per drafted and verified row, measured on gfx1201 with the release; down two widths at a time, up one, at most once in
8 drafts, for a gain above 1 %).  Every 4th draft carries one token past w so it can grow.  Unset or 0, nothing changes.

The estimates come from the sequence's history: at its next draft, the last draft is compared with the tokens the target
produced after it (a draft token equal to the target's token at its position is one the verification accepts, under
greedy match and under rejection sampling alike).  Per position they are decayed counts (P(k accepted | k-1 accepted) =
hits / checks) with two pseudo-checks at the previous position's estimate, so a position the sequence seldom reaches is
not taken for a good one.  Nothing hooks accept() / accept_partial().

On a hybrid or recurrent target (spec_align_enabled(), issue #234), the sequences drafted in one call send one width,
the widest among them, bounded by the lowest hard cap of the call and by the expert cache's verify band, as
align_draft_caps() does for draft-mtp-adaptive.  No cut of finished drafts.

LLAMA_DFLASH_ADAPTIVE=2 also logs the width changes; LLAMA_SPEC_ALIGN=0 drops the alignment;
LLAMA_DFLASH_ADAPTIVE_COST / LLAMA_DFLASH_ADAPTIVE_JUMP override the cost model.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/speculative.cpp | 236 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 235 insertions(+), 1 deletion(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index 9355f2680..0a6513096 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -14,6 +14,7 @@
 #include "../src/llama-ext.h" // staging API: llama_set_embeddings_nextn / llama_get_embeddings_nextn_ith (used by MTP)
 
 #include <algorithm>
+#include <numeric>
 #include <cassert>
 #include <cmath>
 #include <cstring>
@@ -1081,6 +1082,49 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
     // (A LLAMA_SWA_TYPE_CHUNKED window reaches back to the chunk start -- up to 2*n_swa-1 -- and would need a wider tail.)
     int32_t                ingest_window = 0;
     std::vector<llama_pos> ingest_from;
+    // adaptive verify width (DFlash2; opt-in: LLAMA_DFLASH_ADAPTIVE=1, 2 also logs the width changes): a sequence drafts w
+    // tokens and sends them to verification.  w follows the estimated acceptance at each position to the width with the
+    // most tokens per unit of step cost (down two at a time, up one, at most once in 8 drafts and for a gain above 1 %:
+    // a response's first drafts often run below its later acceptance), so the target rebuilds its verify graph rarely.  A draft verified at w shows what a narrower width would have
+    // accepted; every 4th draft is one token longer than w, and when the w tokens are accepted the target's next token
+    // tells whether that one would have been, which is what lets w grow again.  The estimates come from the sequence's own
+    // history (adapt_review()), not from accept()
+    struct adapt_state {
+        int32_t                  w      = 0;  // tokens sent to verification
+        int32_t                  since  = 0;  // reviews since w last changed
+        int32_t                  step   = 0;  // drafts so far (every 4th drafts one token past w)
+        int32_t                  pos    = 0;  // position of the sequence's last draft (the context length the cost sees)
+        std::vector<llama_token> d;           // the last draft as drafted, up to the token past the width it was sent at
+        size_t                   at     = 0;  // prompt length when it was drafted (the target's next tokens follow there)
+        llama_token              last   = LLAMA_TOKEN_NULL; // that round's id_last (prompt[at] once the round is in)
+        int32_t                  n_sent = 0;  // its tokens sent to verification
+        // per position k: the reviewed drafts in which position k was checked (every earlier one accepted) and those in which
+        // it was accepted too, both decayed by ADAPT_DECAY per review, so P(k accepted | k-1 accepted) is a count ratio
+        std::vector<float>       n_seen;
+        std::vector<float>       n_hit;
+        std::vector<int32_t>     hist;        // drafts per width sent over the request
+    };
+    // the estimate of a position checked in few drafts leans on ADAPT_PRIOR_N pseudo-drafts at the previous position's
+    // estimate (0.5 for the first), so a position the sequence seldom reaches is not taken for a good one
+    static constexpr float    ADAPT_DECAY   = 31.0f / 32.0f;
+    static constexpr float    ADAPT_PRIOR_N = 2.0f;
+    bool                      adapt      = false;
+    // issue #234 for the adaptive width (spec_align_enabled(), on a hybrid or recurrent target only): the sequences drafted
+    // in one call send one width, the widest among them, so the verify batch is not split into ubatches by length
+    bool                      align      = false;
+    int                       adapt_log  = 0;
+    // one more drafted and verified position, as a fraction of the step's fixed part (LLAMA_DFLASH_ADAPTIVE_COST): on
+    // gfx1201 with Qwen3.8-27B + DFlash2 a step costs about 31 ms + 2.4..3.1 ms per row from 0.5K to 30K positions, most of
+    // the row cost in the draft's block, i.e. 0.08..0.10
+    float                     adapt_cost = 0.09f;
+    // the step's extra cost once the verify batch reaches 5 rows, as a fraction of a step at 110K positions (scaled with the
+    // context, at most twice; LLAMA_DFLASH_ADAPTIVE_JUMP): for a tree whose decode attention switches tiles there.  The
+    // release shows no such step (0)
+    float                     adapt_jump = 0.0f;
+    // the expert cache's verify band (llama_model_moe_cache_band(), 0 without an active arena): the aligned width keeps the
+    // verify batch inside it, as align_draft_caps() does for draft-mtp-adaptive (GREEDY-PURITY section 50)
+    int32_t                   band       = 0;
+    std::vector<adapt_state>  adapt_st;
 
     const int32_t * target_layer_ids   = nullptr; // model_dft's extract layer indices
     uint32_t        target_layer_ids_n = 0;
@@ -1146,6 +1190,26 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
             ingest_from.assign(n_seq, 0);
         }
 
+        {
+            const char * ad = getenv("LLAMA_DFLASH_ADAPTIVE"); // 0 = off (default), 1 = on, 2 = on and log the width changes
+            adapt_log = ad != nullptr ? atoi(ad) : 0;
+            adapt     = is_dflash2 && adapt_log > 0;
+            if (adapt && spec_align_enabled() && this->params.ctx_tgt != nullptr) {
+                const llama_model * model_tgt = llama_get_model(this->params.ctx_tgt);
+                align = llama_model_is_recurrent(model_tgt) || llama_model_is_hybrid(model_tgt);
+                // read once the target context exists: the band answers from the arena's real state
+                band  = llama_model_moe_cache_band(model_tgt);
+            }
+            const char * ac = getenv("LLAMA_DFLASH_ADAPTIVE_COST");
+            if (ac != nullptr && atof(ac) > 0.0) {
+                adapt_cost = (float) atof(ac);
+            }
+            const char * aj = getenv("LLAMA_DFLASH_ADAPTIVE_JUMP");
+            if (aj != nullptr) {
+                adapt_jump = std::max(0.0f, (float) atof(aj));
+            }
+        }
+
         if (is_dspark && this->params.p_min > 0.0f) {
             char buf[16] = {};
             const bool has_conf =
@@ -1176,6 +1240,16 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         }
         this->n_max = this->params.n_max;
 
+        if (adapt) {
+            adapt_st.resize(n_seq);
+            for (llama_seq_id s = 0; s < (llama_seq_id) n_seq; ++s) {
+                adapt_reset(s);
+            }
+            LOG_INF("%s: - adaptive verify width 1..%d, start %d, cost of a verified position %.3f of a step, %.3f more from 5 rows at "
+                    "110K, %s, band %d (LLAMA_DFLASH_ADAPTIVE=0: fixed width)\n", __func__, this->params.n_max, adapt_st[0].w, adapt_cost,
+                    adapt_jump, align ? "sequences drafted together aligned to the widest" : "no alignment", band);
+        }
+
         batch        = common_batch(ctx_dft);
         batch_inject = common_batch(ctx_dft);
 
@@ -1266,6 +1340,18 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         // reseed per request rather than per round, or two identical requests differ
         dflash2_seed[seq_id] = -1;
 
+        if (adapt) {
+            const auto & st = adapt_st[seq_id];
+            if (adapt_log > 1 && st.since + std::accumulate(st.hist.begin(), st.hist.end(), 0) > 0) {
+                std::string h;
+                for (size_t w = 1; w < st.hist.size(); ++w) {
+                    h += string_format(" %zu:%d", w, st.hist[w]);
+                }
+                LOG_INF("%s: adaptive verify width seq %d, verifications per width:%s\n", __func__, (int) seq_id, h.c_str());
+            }
+            adapt_reset(seq_id);
+        }
+
         const int32_t N = (int32_t) prompt.size();
         if (N <= 0) {
             return;
@@ -1469,6 +1555,42 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         std::vector<int32_t> i_block_beg(n_seq, -1);
         std::vector<int32_t> n_block    (n_seq,  0);
 
+        // with the adaptive width a sequence drafts its w tokens, and one more on every 4th draft so that draft token w+1
+        // can be checked against the target; the blocks of one batch have one length (the selector reads equal blocks),
+        // the longest asked for
+        int32_t n_draft = params.n_max;
+        // the width a sequence sends: its own w, or, when several sequences draft together and `align` is set, the widest w
+        // among them (raising a narrow sequence costs a few verify rows; a split costs a second pass over the weights),
+        // either one bounded by the hard caps of the call (--spec-draft-n-max and the caller's per-sequence n_max, which
+        // the server lowers as a response runs out of tokens; the lowest one for the aligned width, as align_draft_caps()),
+        // and the aligned one by the expert cache's verify band
+        int32_t w_align = 0;
+        if (adapt) {
+            n_draft = 1;
+            int32_t n_together = 0;
+            int32_t n_hard_lo  = params.n_max;
+            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                const auto & dp = dparams[seq_id];
+                if (!dp.drafting) {
+                    continue;
+                }
+                adapt_review(seq_id, dp);
+                auto & st = adapt_st[seq_id];
+                const bool probe = st.step++ % 4 == 0;
+                n_draft = std::max(n_draft, std::min(params.n_max, st.w + (probe ? 1 : 0)));
+                n_together++;
+                w_align = std::max(w_align, st.w);
+                if (dp.n_max > 0) {
+                    n_hard_lo = std::min(n_hard_lo, dp.n_max);
+                }
+            }
+            w_align = align && n_together > 1 ? std::min(w_align, n_hard_lo) : 0;
+            if (w_align > 0 && band > 1) {
+                // 0 when the band cannot hold the sequences at any width: each sends its own, as align_draft_caps() leaves them
+                w_align = std::max(0, std::min(w_align, band / n_together - 1));
+            }
+        }
+
         for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
             auto & dp = dparams[seq_id];
             if (!dp.drafting) {
@@ -1478,8 +1600,10 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
             common_sampler_reset(smpls[seq_id].get());
 
             const int32_t n = (int32_t) dp.pos0;
+            if (adapt) {
+                adapt_st[seq_id].pos = n;
+            }
 
-            const int32_t n_draft = params.n_max;
             const int32_t n_block_tokens = is_lilicorr ? block_size : n_draft + (is_dspark && sample_from_anchor ? 0 : 1);
             i_block_beg[seq_id] = batch.size();
             n_block    [seq_id] = n_block_tokens;
@@ -1588,6 +1712,23 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
                     result.push_back((llama_token) row[predecessor]);
                 }
 
+                if (adapt) {
+                    auto & st = adapt_st[seq_id];
+                    const int32_t w = w_align > 0 ? w_align : (dp.n_max > 0 ? std::min(st.w, dp.n_max) : st.w);
+                    if (dp.prompt != nullptr) {
+                        st.d.assign(result.begin(), result.begin() + std::min<size_t>(result.size(), w + 1));
+                        st.at   = dp.prompt->size();
+                        st.last = dp.id_last;
+                    }
+                    if ((int32_t) result.size() > w) {
+                        result.resize(w);
+                        if (sample) {
+                            dp.result_q->resize(w);
+                        }
+                    }
+                    st.n_sent = (int32_t) result.size();
+                }
+
                 if (result.size() < (size_t) params.n_min) {
                     result.clear();
                     if (sample) {
@@ -1656,6 +1797,99 @@ struct common_speculative_impl_draft_dflash : public common_speculative_impl {
         }
     }
 
+    void adapt_reset(llama_seq_id seq_id) {
+        auto & st = adapt_st[seq_id];
+        st = adapt_state();
+        const int32_t n_max = std::max(1, params.n_max);
+        st.w = params.n_start > 0 ? std::min(params.n_start, n_max) : n_max;
+        st.n_seen.assign(n_max, 0.0f);
+        st.n_hit .assign(n_max, 0.0f);
+        st.hist.assign(n_max + 1, 0);
+    }
+
+    // expected tokens per unit of step cost when w drafted tokens are verified
+    float adapt_value(const adapt_state & st, int32_t w) const {
+        float p    = 1.0f;
+        float e    = 1.0f;
+        float prev = 0.5f;
+        for (int32_t k = 0; k < w; ++k) {
+            const float h = (st.n_hit[k] + ADAPT_PRIOR_N*prev) / (st.n_seen[k] + ADAPT_PRIOR_N);
+            p   *= h;
+            e   += p;
+            prev = h;
+        }
+        const float jump = w + 1 >= 5 ? adapt_jump * std::min(2.0f, (float) st.pos / 110000.0f) : 0.0f;
+        return e / (1.0f + adapt_cost * (w + 1) + jump);
+    }
+
+    // the last draft of `seq_id` against what the target produced after it.  Since that draft the prompt has grown by
+    // that round's id_last and the tokens the target kept, and dp.id_last is the target's token after them.  A draft token
+    // equal to the target's token at its position is one the verification accepts (greedy match; under rejection sampling
+    // a rejected token is never the replacement), so the estimates need neither accept() nor the length the draft was
+    // verified at: a draft cut after draft() returned, a round replayed from a checkpoint, or rounds drafted by another
+    // implementation in between leave the same history
+    void adapt_review(llama_seq_id seq_id, const common_speculative_draft_params & dp) {
+        auto & st = adapt_st[seq_id];
+        if (st.d.empty() || dp.prompt == nullptr) {
+            return;
+        }
+        const std::vector<llama_token> d = std::move(st.d);
+        st.d.clear();
+        const llama_tokens & prompt = *dp.prompt;
+        if (prompt.size() <= st.at || prompt[st.at] != st.last) {
+            return; // the sequence was rewound or holds another request
+        }
+        for (size_t k = 0; k < st.n_seen.size(); ++k) {
+            st.n_seen[k] *= ADAPT_DECAY;
+            st.n_hit [k] *= ADAPT_DECAY;
+        }
+        for (int32_t k = 0; k < (int32_t) d.size() && k < (int32_t) st.n_seen.size(); ++k) {
+            const size_t i = st.at + 1 + k;
+            if (i > prompt.size()) {
+                break; // the target has not produced this position yet
+            }
+            const bool hit = d[k] == (i < prompt.size() ? prompt[i] : dp.id_last);
+            st.n_seen[k] += 1.0f;
+            st.n_hit [k] += hit ? 1.0f : 0.0f;
+            if (!hit) {
+                break;
+            }
+        }
+        if (st.n_sent > 0) {
+            st.hist[std::min<size_t>(st.n_sent, st.hist.size() - 1)]++;
+        }
+
+        if (++st.since < 8) {
+            return;
+        }
+        // every position up to w+1 has fresh estimates: up to two shorter, or one longer
+        int32_t best = st.w;
+        const float v_cur = adapt_value(st, st.w);
+        float       v_best = v_cur;
+        for (int32_t c = std::max(1, st.w - 2); c <= std::min<int32_t>(st.w + 1, st.n_seen.size()); ++c) {
+            const float v = adapt_value(st, c);
+            if (v > v_best) {
+                best   = c;
+                v_best = v;
+            }
+        }
+        if (v_best < 1.01f * v_cur) {
+            best = st.w;
+        }
+        if (best != st.w) {
+            if (adapt_log > 1) {
+                std::string h;
+                for (size_t k = 0; k < st.n_seen.size(); ++k) {
+                    h += string_format(" %.1f/%.1f", st.n_hit[k], st.n_seen[k]);
+                }
+                LOG_INF("%s: adaptive verify width seq %d: %d -> %d (acceptance per position:%s)\n", __func__,
+                        (int) seq_id, st.w, best, h.c_str());
+            }
+            st.w     = best;
+            st.since = 0;
+        }
+    }
+
     void accept(llama_seq_id /*seq_id*/, uint16_t /*n_accepted*/, bool /*is_other*/) override {
         // noop
     }
-- 
